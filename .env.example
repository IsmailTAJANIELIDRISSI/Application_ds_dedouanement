# Gemini API Configuration
# Get your API key from: https://makersuite.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# BADR Configuration
# Password for BADR login (each user's password)
BADR_PASSWORD=your_password_here

# Edge Browser Paths
# Adjust these paths based on your system and USB key configuration
# Common Edge installation path (64-bit)
EDGE_PATH=C:\Program Files (x86)\Microsoft\Edge\Application\msedge.exe

# EdgeDriver path (download from: https://developer.microsoft.com/en-us/microsoft-edge/tools/webdriver/)
# Can be on USB key or local Downloads folder
DRIVER_PATH=C:\Users\YourUsername\Downloads\edgedriver_win64\msedgedriver.exe

# Alternative paths examples:
# USB Key: D:\edgedriver_win64\msedgedriver.exe
# Custom location: C:\Tools\edgedriver\msedgedriver.exe
